# 依赖：通过 package.json 和 package-lock.json 恢复
node_modules/

# 构建结果与 Windows 解包应用
/out/
/dist/

# 本地自检报告、截图、测试数据库与工具缓存
/.artifacts/
/.cache/
/coverage/
/.nyc_output/
*.tsbuildinfo
*.log

# 本地环境变量；可提交不含秘密的环境示例
.env
.env.*
!.env.example

# 生成的本地 SQLite 数据及其事务文件
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite-journal
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.sqlite3-journal

# 本地签名证书与私钥
*.pfx
*.p12
*.key

# 个人 IDE 状态与操作系统产生的文件
.idea/
*.code-workspace
*.suo
*.user
.DS_Store
Thumbs.db
Desktop.ini

# 保留源码、测试、assets、Docs、AGENTS.md、项目配置及 package-lock.json。
# 不全局忽略图片、模型、ZIP 或 EXE：项目资源应按用途决定是否跟踪。
